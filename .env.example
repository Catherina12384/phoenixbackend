# Copy to .env (git-ignored) for local development.
DB_URL=jdbc:postgresql://localhost:5432/phoenix
DB_USER=phoenix
DB_PASSWORD=phoenix
DB_POOL_SIZE=5

# Each at least 32 characters, and different from each other.
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HMAC_SECRET=replace-with-another-32-random-characters

# logging = print OTPs in the console (dev profile only). msg91 = real SMS.
OTP_SENDER=logging
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# First admin, created at startup. Set all three or none.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Production behind nginx on the same domain as the site:
#   COOKIE_SECURE=true   TRUSTED_PROXIES=127.0.0.1
COOKIE_SECURE=true
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
SWAGGER_ENABLED=false
